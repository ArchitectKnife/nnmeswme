# Скопируйте в .env и заполните. Файл .env не коммитится.
PORT=3000
HOST=0.0.0.0
# Публичный адрес сайта (нужен для Steam OpenID, ссылок в письмах и реферальных ссылок)
PUBLIC_URL=
# 1 — ставить Secure на cookie (обязательно при HTTPS)
COOKIE_SECURE=0
# 1 — доверять X-Forwarded-For (только за своим reverse proxy)
TRUST_PROXY=0
# Ключ Steam Web API (https://steamcommunity.com/dev/apikey) — для имени и аватара при входе через Steam
STEAM_API_KEY=
# SMTP для писем восстановления пароля и уведомлений
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Первый владелец сайта (используется только командой npm run create-owner)
OWNER_LOGIN=
OWNER_EMAIL=
OWNER_PASSWORD=
# Где хранить базу, загрузки и резервные копии
DATA_DIR=./data
# DB_FILE=./data/burger.sqlite
# Платёжные провайдеры включаются только после юридической проверки и подписания договора:
# PAYMENT_<ID>_ENABLED=1
